# ---------------------------------------------------------------------------
# Backend (Node/Express) — server-side only. Never commit a real .env file.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Comma-separated browser origins allowed to call the API, or * in local dev.
# Example: https://jhsoaps.com,https://www.jhsoaps.com
# Development also accepts any http://localhost:<port> origin automatically.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_APP_URL=http://localhost:5174

# MongoDB Atlas connection string. URL-encode the password if it contains
# characters such as @, :, /, ?, # or %. Keep the database name in DB_NAME.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=jh_soaps

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=jh-soaps
JWT_AUDIENCE=jh-web
COOKIE_NAME=jh_session
COOKIE_SECURE=false

# Used only by `npm run db:seed:admin`. Leave blank if you do not need to
# create an administrator yet. Quote passwords containing #, spaces or $ so
# dotenv does not truncate them (for example "My#Pass 2026").
ADMIN_ROLE=super_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional Razorpay server-side integration. Leave blank to keep COD-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stripe Checkout — server-side only. Never expose these in Vite/frontend code.
# Get the secret key from https://dashboard.stripe.com/apikeys
# Create the webhook endpoint at /api/payments/stripe/webhook and subscribe to:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired
#   charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Dashboard payment-method settings control what Checkout displays.
# These values are fallback hints used only if the configuration cannot be read.
STRIPE_ENABLE_UPI=true
STRIPE_PAYMENT_METHODS=card,upi
STRIPE_CURRENCY=inr
STRIPE_SESSION_TTL_MINUTES=30

# Optional password-reset email delivery via Resend.
RESEND_API_KEY=
AUTH_FROM_EMAIL=no-reply@jhsoaps.com

# Optional phone OTP delivery via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Frontend (Vite) — only VITE_* variables reach the browser.
# In development keep /api so Vite proxies to the Express server and requests
# stay same-origin. Set an absolute URL only when the frontend is deployed
# separately from the API, e.g. https://api.jhsoaps.com/api
# ---------------------------------------------------------------------------
VITE_API_URL=/api
